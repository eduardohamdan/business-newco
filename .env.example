# ---------------------------------------------------------------------------
# Business Evolution OS — variáveis de ambiente
# Copie para .env e preencha. Nunca versione o .env.
# ---------------------------------------------------------------------------

# App
APP_URL=http://localhost:3000
APP_ENV=development                # development | staging | production
SESSION_SECRET=troque-por-32-bytes-aleatorios-em-base64

# Banco (o app conecta com o papel beos_app, SEM bypass de RLS)
DATABASE_URL=postgres://beos_app:beos_app@localhost:5432/beos
# Migrações rodam com um papel dono/superuser
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/beos

# Armazenamento de arquivos: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=sa-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Processamento: true = processa o Raio-X na própria requisição (dev sem worker)
PROCESS_INLINE=true
PDF_EXTRACTOR_URL=http://localhost:8090

# IA — gateway com dois fornecedores (primário + fallback). provider: anthropic | openai | mock
AI_PRIMARY_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock
AI_MODEL_FAST_ANTHROPIC=claude-haiku-4-5
AI_MODEL_REASONING_ANTHROPIC=claude-sonnet-4-5
AI_MODEL_FAST_OPENAI=gpt-4.1-mini
AI_MODEL_REASONING_OPENAI=gpt-4.1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Preço por 1M tokens em USD (entrada/saída) para controle de custo. Ajuste à tabela vigente do fornecedor.
AI_PRICE_FAST_IN=1
AI_PRICE_FAST_OUT=5
AI_PRICE_REASONING_IN=3
AI_PRICE_REASONING_OUT=15
USD_BRL=5.40

# Transcrição de áudio (STT): openai | mock
STT_PROVIDER=mock
STT_MODEL=whisper-1

# WhatsApp Cloud API (Meta). provider: cloud | mock
WHATSAPP_PROVIDER=mock
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=troque-este-token

# E-mail: console | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM="Business Evolution OS <nao-responda@exemplo.com.br>"
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=

# Pagamentos: asaas | mock
BILLING_PROVIDER=mock
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Operação interna (e-mails com acesso ao painel /interno, separados por vírgula)
INTERNAL_OPERATOR_EMAILS=
